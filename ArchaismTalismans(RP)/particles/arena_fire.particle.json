{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "arena:fire_particle",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "textures/particles/arena_fire_particle"
			}
		},
		"curves": {
			"variable.time": {
				"type": "linear",
				"input": "v.particle_age",
				"horizontal_range": "v.particle_lifetime",
				"nodes": [0, 1]
			}
		},
		"components": {
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 2,
				"max_particles": 2
			},
			"minecraft:emitter_lifetime_looping": {
				"active_time": 1.4
			},
			"minecraft:emitter_shape_disc": {
				"offset": [0, 0, 0],
				"radius": 2.9,
				"surface_only": true,
				"direction": [0, 1, 0]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "0.5 + variable.particle_random_3"
			},
			"minecraft:particle_initial_speed": "math.random(1, 4)",
			"minecraft:particle_motion_dynamic": {},
			"minecraft:particle_appearance_billboard": {
				"size": [0.1, 0.1],
				"facing_camera_mode": "lookat_xyz",
				"uv": {
					"texture_width": 16,
					"texture_height": 80,
					"flipbook": {
						"base_UV": ["Math.floor(v.particle_random_3 * 2) * 8", "Math.floor(v.particle_random_4 * 2) * 8"],
						"size_UV": [8, 8],
						"step_UV": [0, 8],
						"frames_per_second": 18,
						"max_frame": 10,
						"stretch_to_lifetime": true
					}
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "variable.particle_random_2",
					"gradient": {
						"0.0": "#ffffffff",
						"0.4": "#FFFFE1B9",
						"1.0": "#FFFFCACA"
					}
				}
			}
		}
	}
}