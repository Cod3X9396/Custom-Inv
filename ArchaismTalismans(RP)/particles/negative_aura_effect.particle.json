{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "arena:negative_aura_effect",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "textures/particles/arena_skull"
			}
		},
		"curves": {
			"variable.time": {
				"type": "linear",
				"input": "v.particle_age",
				"horizontal_range": "v.particle_lifetime",
				"nodes": [0, 1]
			}
		},
		"components": {
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 70,
				"max_particles": 70
			},
			"minecraft:emitter_lifetime_looping": {
				"active_time": 1.4
			},
			"minecraft:emitter_shape_disc": {
				"offset": [0, 1, 0],
				"radius": 6,
				"surface_only": true,
				"direction": [0, 1, 0]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": 1.5
			},
			"minecraft:particle_initial_speed": "math.random(1, 5)",
			"minecraft:particle_motion_dynamic": {
				"linear_drag_coefficient": 4
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["(0.1 + variable.particle_random_1*0.1) - (0.1 * variable.particle_age)", "(0.1 + variable.particle_random_1*0.1) - (0.1 * variable.particle_age)"],
				"facing_camera_mode": "lookat_xyz",
				"direction": {
					"mode": "derive_from_velocity",
					"min_speed_threshold": 0.001
				}
			},
			"minecraft:particle_motion_collision": {
				"collision_drag": 0.1,
				"collision_radius": 0.2
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "variable.particle_random_2",
					"gradient": {
						"0.0": "#ffffffff",
						"0.4": "#FFFFE1B9",
						"1.0": "#FFFFCACA"
					}
				}
			}
		}
	}
}